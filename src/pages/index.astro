---
import { Icon } from "astro-icon/components";
import PostPage from "@/components/layout/PostPage.astro";
import HomeAnnouncement from "@/components/pages/home/HomeAnnouncement.astro";
import HomeClock from "@/components/pages/home/HomeClock.svelte";
import HomeExplore from "@/components/pages/home/HomeExplore.astro";
import HomeLatestPosts from "@/components/pages/home/HomeLatestPosts.astro";
import HomeMusic from "@/components/pages/home/HomeMusic.svelte";
import HomeProfile from "@/components/pages/home/HomeProfile.astro";
import HomeStats from "@/components/pages/home/HomeStats.astro";
import { homeConfig, siteConfig } from "@/config";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import { getSortedPosts } from "@/utils/content-utils";
import { url } from "@/utils/url-utils";

// 官网风格首页；文章列表位于 /posts/（配置见 homeConfig）
const homeEnabled = homeConfig.enable === true;

// 回退模式（homeConfig.enable = false）下，首页直接渲染文章列表第一页
const allBlogPosts = await getSortedPosts();
const pageSize = siteConfig.pagination.postsPerPage;
const fallbackPosts = allBlogPosts.slice(0, pageSize);
const fallbackHasNext = allBlogPosts.length > pageSize;
const fallbackLastPage = Math.max(1, Math.ceil(allBlogPosts.length / pageSize));

// 首页隐藏侧边栏（官网风格全宽板块），侧栏仍会渲染并由运行时脚本隐藏以保证 Swup 一致性
const hideSidebar = homeEnabled;
const showStatsRow =
	homeEnabled && (homeConfig.clock.enable || homeConfig.stats.enable);
---

{/* 标记 JS 可用后板块才隐藏等待入场动画；无 JS 时保持可见 */}
<script is:inline>
	document.documentElement.classList.add("reveal-pending");
</script>

<MainGridLayout title={siteConfig.title} hideSidebar={hideSidebar}>
  {
    homeEnabled ? (
      <div id="home-sections" class="flex flex-col gap-10 md:gap-14">
        {homeConfig.announcement.enable && <HomeAnnouncement />}
        {showStatsRow && (
          <div class="reveal-section flex flex-wrap items-end justify-between gap-x-10 gap-y-8">
            {homeConfig.clock.enable && <HomeClock client:load />}
            {homeConfig.stats.enable && <HomeStats />}
          </div>
        )}
        {homeConfig.sectionCards.enable && <HomeExplore class="reveal-section" />}
        {(homeConfig.profile.enable || homeConfig.music.enable) && (
          <div class="reveal-section grid grid-cols-1 gap-4 lg:grid-cols-2">
            {homeConfig.profile.enable && <HomeProfile />}
            {homeConfig.music.enable && <HomeMusic client:load />}
          </div>
        )}
        {homeConfig.latestPosts.enable && <HomeLatestPosts class="reveal-section" />}
      </div>
    ) : (
      <>
        <PostPage page={{ data: fallbackPosts }} />
        {fallbackLastPage > 1 && (
          <div
            class="mx-auto flex flex-row items-center justify-center gap-3 onload-animation"
            role="navigation"
            aria-label={i18n(I18nKey.postList)}
            style={`animation-delay: calc(var(--content-delay) + ${fallbackPosts.length * 50}ms)`}
          >
            <a
              href="#"
              aria-label={i18n(I18nKey.paginationPrev)}
              aria-disabled="true"
              tabindex="-1"
              class:list={[
                "btn-card overflow-hidden rounded-(--radius-large) text-(--primary) w-11 h-11",
                "opacity-50 cursor-not-allowed",
              ]}
            >
              <Icon is:inline name="material-symbols:chevron-left-rounded" class="text-[1.75rem]" aria-hidden="true" />
            </a>
            <div class="btn-card flex items-center rounded-(--radius-large) px-4 h-11 gap-1.5">
              <span class="text-base font-bold text-(--primary)">1</span>
              <span class="text-sm text-neutral-500 dark:text-neutral-500">/</span>
              <span class="text-base font-bold text-neutral-700 dark:text-neutral-300">{fallbackLastPage}</span>
            </div>
            <a
              href={fallbackHasNext ? url("/posts/page/2/") : "#"}
              aria-label={i18n(I18nKey.paginationNext)}
              aria-disabled={fallbackHasNext ? "false" : "true"}
              tabindex={fallbackHasNext ? "0" : "-1"}
              class:list={[
                "btn-card overflow-hidden rounded-(--radius-large) text-(--primary) w-11 h-11",
                fallbackHasNext ? "" : "opacity-50 cursor-not-allowed",
              ]}
            >
              <Icon is:inline name="material-symbols:chevron-right-rounded" class="text-[1.75rem]" aria-hidden="true" />
            </a>
          </div>
        )}
      </>
    )
  }
</MainGridLayout>

<!-- 滚动入场动画的扫描器在 Layout.astro 全局脚本中（reveal-pending 标记 + .reveal-section 隐藏态见下方样式）；
     扫描器不能放在本页模块脚本里——Swup 导航进入本页时页面模块脚本不会重新执行，监听会缺失 -->

<style is:global>
  /* 首页衬线标题（中文衬线，与 Hero 标题同一字体来源） */
  .home-serif-title {
    font-family:
      var(--font-noto-serif-sc),
      "Noto Serif SC",
      "Songti SC",
      "STSong",
      "SimSun",
      serif;
  }

  /* 滚动入场动画：初始态仅在 JS 可用（html.reveal-pending）时生效 */
  html.reveal-pending .reveal-section {
    opacity: 0;
    transform: translateY(26px);
    transition:
      opacity 0.7s ease-out,
      transform 0.7s cubic-bezier(0.22, 0.61, 0.36, 1);
  }

  html.reveal-pending .reveal-section.revealed {
    opacity: 1;
    transform: none;
  }

  @media (prefers-reduced-motion: reduce) {
    html.reveal-pending .reveal-section {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>
