---
import { Icon } from "astro-icon/components";
import { homeConfig, siteConfig } from "@/config";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import {
	getCategoryList,
	getSortedPosts,
	getTagList,
} from "@/utils/content-utils";

interface Props {
	class?: string;
	style?: string;
}

const { class: className, style } = Astro.props;

const posts = await getSortedPosts();
const categories = await getCategoryList();
const tags = await getTagList();

// 计算总字数（移除代码块后统计中英文字符）
let totalWords = 0;
for (const post of posts) {
	if (post.body) {
		const text = post.body
			.replace(/```[\s\S]*?```/g, "")
			.replace(/`[^`]*`/g, "")
			.replace(/\s+/g, " ")
			.trim();
		const chineseChars = text.match(/[\u4e00-\u9fa5]/g) || [];
		const englishChars = text.match(/[a-zA-Z]/g) || [];
		totalWords += chineseChars.length + englishChars.length;
	}
}

// 运行天数（构建时计算，随部署刷新）
const siteStartDate = siteConfig.siteStartDate || "2025-01-01";
const runningDays = Math.ceil(
	Math.abs(Date.now() - new Date(siteStartDate).getTime()) /
		(1000 * 60 * 60 * 24),
);

const stats = [
	{
		icon: "material-symbols:article-outline",
		label: i18n(I18nKey.siteStatsPostCount),
		value: posts.length.toLocaleString(),
	},
	{
		icon: "material-symbols:folder-outline",
		label: i18n(I18nKey.siteStatsCategoryCount),
		value: categories.length.toLocaleString(),
	},
	{
		icon: "material-symbols:label-outline",
		label: i18n(I18nKey.siteStatsTagCount),
		value: tags.length.toLocaleString(),
	},
	...(homeConfig.stats.showWords
		? [
				{
					icon: "material-symbols:text-ad-outline-rounded",
					label: i18n(I18nKey.siteStatsTotalWords),
					value: totalWords.toLocaleString(),
				},
			]
		: []),
	{
		icon: "material-symbols:calendar-clock-outline",
		label: i18n(I18nKey.siteStatsRunningDays),
		value:
			`${runningDays} ${i18n(I18nKey.siteStatsDays).replace("{days}", "")}`.trim(),
	},
];
---

<section
  class:list={["card-base rounded-(--radius-large) p-4 md:p-6 onload-animation", className]}
  style={style}
  aria-label={i18n(I18nKey.siteStats)}
>
  <div class="grid h-full grid-cols-2 content-center gap-x-4 gap-y-5 md:grid-cols-3">
    {
      stats.map((stat) => (
        <div class="flex items-center gap-3">
          <div class="h-10 w-10 shrink-0 rounded-lg bg-(--btn-plain-bg-hover) flex items-center justify-center text-(--primary)">
            <Icon is:inline name={stat.icon} class="h-5 w-5" aria-hidden="true" />
          </div>
          <div class="flex min-w-0 flex-col">
            <span class="truncate text-lg font-bold leading-tight text-black/85 dark:text-white/85">{stat.value}</span>
            <span class="text-xs text-black/50 dark:text-white/50">{stat.label}</span>
          </div>
        </div>
      ))
    }
  </div>
</section>
