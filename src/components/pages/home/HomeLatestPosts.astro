---
import { Icon } from "astro-icon/components";
import CoverImage from "@/components/common/CoverImage.astro";
import { homeConfig } from "@/config";
import I18nKey from "@/i18n/i18nKey";
import { render } from "astro:content";
import { i18n } from "@/i18n/translation";
import { getSortedPosts } from "@/utils/content-utils";
import { formatDateToYYYYMMDD } from "@/utils/date-utils";
import { getApiUrlList, processCoverImageSync } from "@/utils/image-utils";
import { getFileDirFromPath, getPostUrlBySlug, url } from "@/utils/url-utils";

interface Props {
	class?: string;
	style?: string;
}

const { class: className, style } = Astro.props;

const sectionTitle = homeConfig.latestPosts.title ?? i18n(I18nKey.recentPosts);
const cardWidth = homeConfig.latestPosts.cardWidth ?? 380;
const coverHeight = homeConfig.latestPosts.coverHeight ?? 185;
const streamScroll = homeConfig.latestPosts.streamScroll ?? 0.6;

const allPosts = await getSortedPosts();
const latestPostsRaw = allPosts.slice(0, homeConfig.latestPosts.count || 4);

// 取每篇文章的摘要与阅读时长（参考 kanako：分类/标题/时间/摘要/标签 信息密度）
const latestPosts = await Promise.all(
	latestPostsRaw.map(async (entry) => {
		const { remarkPluginFrontmatter } = await render(entry);
		return {
			entry,
			title: entry.data.title,
			url: getPostUrlBySlug(entry.id),
			date: formatDateToYYYYMMDD(entry.data.published),
			category: entry.data.category,
			tags: (entry.data.tags ?? []).slice(0, 2),
			cover: processCoverImageSync(entry.data.image, entry.id),
			coverBasePath: getFileDirFromPath(entry.filePath || ""),
			coverApiUrls: getApiUrlList(entry.data.image, entry.id),
			password: !!entry.data.password,
			excerpt: (entry.data.description ?? remarkPluginFrontmatter.excerpt ?? "").trim(),
			minutes: remarkPluginFrontmatter.minutes,
		};
	}),
);

const showCover = homeConfig.latestPosts.showCover !== false;

const sectionStyle = [
	style ?? "",
	`--stream-card-w: ${cardWidth}px; --stream-cover-h: ${coverHeight}px; --stream-scroll: ${streamScroll};`,
]
	.filter(Boolean)
	.join(" ");
---

<!-- 最新文章卡片流：滚动经过时卡片从右向左划过（transit scrub 编排见 utils/motion.ts setupPostStream） -->
<section
	id="home-posts-stream"
	class:list={["stream-section", className ?? ""]}
	style={sectionStyle}
	data-motion="stream"
	aria-label={sectionTitle}
>
	<div
		class="stream-stage"
		tabindex="0"
		aria-label={`${sectionTitle}（可左右滑动查看全部卡片）`}
	>
		<div class="stream-head">
			<h2 class="stream-title">
				<span class="index">02</span>
				{sectionTitle}
			</h2>
			<a class="more-link" href={url("/posts/")}>
				{homeConfig.latestPosts.moreText}
				<Icon
					is:inline
					name="material-symbols:chevron-right-rounded"
					class="h-4.5 w-4.5"
					aria-hidden="true"
				/>
			</a>
		</div>

		<div class="stream-track" id="stream-track">
			{
				latestPosts.map((post, index) => (
					<a class="stream-card" href={post.url} aria-label={post.title}>
						<div class="stream-cover">
							{showCover && post.cover ? (
								<CoverImage
									src={post.cover}
									basePath={post.coverBasePath}
									apiUrls={post.coverApiUrls}
									alt={post.title}
									loading="lazy"
									class="stream-cover-img"
								/>
							) : (
								<div class:list={["stream-cover-ph", `ph-${index % 5}`]}>
									<svg viewBox="0 0 24 24" aria-hidden="true">
										<g fill="currentColor">
											{[0, 72, 144, 216, 288].map((deg) => (
												<path
													d="M12 12 C 19 9.5, 17.5 3.5, 12 1.5 C 6.5 3.5, 5 9.5, 12 12 Z"
													transform={`rotate(${deg} 12 12)`}
												/>
											))}
											<circle cx="12" cy="12" r="1.6" />
										</g>
									</svg>
								</div>
							)}
						</div>
						<div class="stream-info">
							{post.category && <span class="stream-cat">{post.category}</span>}
							<div class="t">
								<span>{post.title}</span>
								{post.password && (
									<Icon
										is:inline
										name="material-symbols:lock-rounded"
										class="lock"
										aria-hidden="true"
									/>
								)}
							</div>
							{post.excerpt && <p class="stream-excerpt">{post.excerpt}</p>}
							<div class="m">
								<span class="font-mono">{post.date}</span>
								{post.minutes && (
									<span class="meta-dot" aria-hidden="true">·</span>
								)}
								{post.minutes && (
									<span>{Math.max(1, Math.round(post.minutes))} min</span>
								)}
								{post.tags.length > 0 && (
									<span class="meta-dot" aria-hidden="true">·</span>
								)}
								{post.tags.map((tag) => (
									<span class="tag">#{tag}</span>
								))}
							</div>
						</div>
					</a>
				))
			}
		</div>
	</div>
</section>

<style>
	.stream-section {
		position: relative;
	}

	/* 横向滚动舞台：整行被 pin 钉住，滚动驱动卡片从右向左流过（motion.ts） */
	/* 横向滚动舞台：整行 pin 钉住（100vh），滚动驱动卡片从右向左流过 */
	.stream-section {
		height: 100vh;
		display: flex;
		flex-direction: column;
		justify-content: center;
		overflow: hidden;
	}

	.stream-stage {
		position: relative;
		padding: 1.5rem 0 2rem;
	}

	.stream-head {
		width: min(1120px, 92vw);
		margin: 0 auto 1.75rem;
		display: flex;
		align-items: baseline;
		justify-content: space-between;
	}

	.stream-title {
		display: flex;
		align-items: baseline;
		gap: 0.75rem;
		font-size: 1.5rem;
		font-weight: 700;
		color: #fff;
		text-shadow: 0 3px 18px rgb(0 0 0 / 0.5);
	}

	.stream-title .index {
		font-family: var(--font-mono, monospace);
		font-size: 0.875rem;
		color: rgb(255 255 255 / 0.45);
	}

	.more-link {
		display: inline-flex;
		align-items: center;
		gap: 0.25rem;
		font-size: 0.8125rem;
		color: rgb(255 255 255 / 0.6);
		transition:
			color 0.15s ease,
			gap 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
	}

	.more-link:hover {
		color: var(--primary);
		gap: 0.5rem;
	}

	.stream-track {
		display: flex;
		width: max-content;
		will-change: transform;
		padding: 2.5rem 0;
		/* 左右内边距 = 内容区居中偏移：起点首卡对齐内容左缘，终点末卡对齐内容右缘 */
		padding-left: max(calc((100vw - 1120px) / 2), 1.5rem);
		padding-right: max(calc((100vw - 1120px) / 2), 1.5rem);
	}

	/* 软 3D 樱粉卡片（呼应草图演示⑥） */
	.stream-card {
		width: min(var(--stream-card-w), 78vw);
		margin-right: 1.6rem;
		flex-shrink: 0;
		border-radius: 22px;
		overflow: hidden;
		background: rgb(255 240 246 / 0.1);
		border: 1.5px solid rgb(255 183 210 / 0.28);
		box-shadow:
			0 14px 30px -16px rgb(90 20 55 / 0.5),
			inset 0 1px 0 rgb(255 255 255 / 0.2);
		transition:
			transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1),
			border-color 0.25s ease,
			box-shadow 0.25s ease;
	}

	.stream-card:hover {
		transform: translateY(-6px) rotate(-1deg);
		border-color: rgb(255 151 188 / 0.65);
		box-shadow:
			0 20px 38px -16px rgb(240 86 143 / 0.5),
			inset 0 1px 0 rgb(255 255 255 / 0.28);
	}

	.stream-cover {
		height: var(--stream-cover-h);
		overflow: hidden;
		position: relative;
	}

	.stream-cover :global(.stream-cover-img) {
		height: var(--stream-cover-h);
		width: 100%;
		min-height: var(--stream-cover-h);
	}

	.stream-cover :global(.stream-cover-img img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	/* 无封面占位：樱花渐变（5 色按序轮换） */
	.stream-cover-ph {
		height: 100%;
		display: grid;
		place-items: center;
	}

	.stream-cover-ph svg {
		width: 64px;
		height: 64px;
		color: rgb(255 255 255 / 0.4);
		filter: drop-shadow(0 4px 14px rgb(0 0 0 / 0.25));
	}

	.stream-cover-ph::after {
		content: "";
		position: absolute;
		inset: 0;
		background: radial-gradient(
			circle at 70% 25%,
			rgb(255 255 255 / 0.28),
			transparent 55%
		);
	}

	.ph-0 {
		background: linear-gradient(135deg, #ffb7d2, #f0568f);
	}

	.ph-1 {
		background: linear-gradient(135deg, #ffd3e4, #ff97bc);
	}

	.ph-2 {
		background: linear-gradient(135deg, #c7b9ff, #8f7be8);
	}

	.ph-3 {
		background: linear-gradient(135deg, #ffe3c2, #ffb287);
	}

	.ph-4 {
		background: linear-gradient(135deg, #bdebe0, #6fc7b2);
	}

	.stream-info {
		padding: 0.9rem 1.1rem 1.05rem;
		display: flex;
		flex-direction: column;
		gap: 0.45rem;
	}

	.stream-cat {
		display: inline-flex;
		align-items: center;
		align-self: flex-start;
		padding: 0.12rem 0.55rem;
		border-radius: 999px;
		background: var(--primary);
		color: #fff;
		font-size: 0.65rem;
		font-weight: 600;
		letter-spacing: 0.08em;
		text-shadow: none;
	}

	.stream-info .t {
		display: flex;
		align-items: center;
		gap: 0.4rem;
		font-size: 1.02rem;
		font-weight: 700;
		line-height: 1.45;
		color: rgb(255 255 255 / 0.95);
		text-shadow: 0 2px 12px rgb(0 0 0 / 0.35);
	}

	.stream-info .t span {
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
		flex: 1;
		min-width: 0;
	}

	.stream-info .lock {
		flex-shrink: 0;
		width: 1rem;
		height: 1rem;
		color: rgb(255 255 255 / 0.45);
	}

	.stream-excerpt {
		margin: 0;
		font-size: 0.78rem;
		line-height: 1.55;
		color: rgb(255 255 255 / 0.65);
		text-shadow: 0 1px 6px rgb(0 0 0 / 0.35);
		display: -webkit-box;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 2;
		overflow: hidden;
	}

	.stream-info .m {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 0.45rem;
		font-size: 0.72rem;
		color: rgb(255 255 255 / 0.5);
		text-shadow: 0 1px 6px rgb(0 0 0 / 0.35);
	}

	.stream-info .m .meta-dot {
		color: rgb(255 255 255 / 0.3);
	}

	.stream-info .m .tag {
		color: rgb(255 183 210 / 0.85);
	}

	@media (max-width: 767px) {
		.stream-head {
			left: 1rem;
			right: 1rem;
		}

		.stream-info .t {
			font-size: 0.95rem;
		}
	}
</style>
