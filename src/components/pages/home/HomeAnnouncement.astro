---
import { announcementConfig, homeConfig } from "@/config";
import { url } from "@/utils/url-utils";

interface Props {
	class?: string;
	style?: string;
}

const { class: className, style } = Astro.props;

const config = announcementConfig;
// 关闭记忆：按内容记忆，内容更新后公告会重新出现
const dismissKey = "home-announcement-dismissed";
---

{
  homeConfig.announcement?.enable && config.content && (
    <div
      id="home-announcement"
      class:list={["announce-bubble sakura-card", className]}
      style={style}
      data-content={config.content}
      role="status"
      aria-live="polite"
    >
      {/* 气泡小尾巴（左下角，朝向左下） */}
      <span class="announce-tail" aria-hidden="true"></span>

      {/* 装饰：飘落樱花瓣（纯 CSS，reduced-motion 关闭） */}
      <div class="announce-deco" aria-hidden="true">
        <svg class="announce-petal p1" viewBox="0 0 24 24">
          <path d="M12 12 C 19 9.5, 17.5 3.5, 12 1.5 C 6.5 3.5, 5  9.5, 12 12 Z" />
        </svg>
        <svg class="announce-petal p2" viewBox="0 0 24 24">
          <path d="M12 12 C 19 9.5, 17.5 3.5, 12 1.5 C 6.5 3.5, 5  9.5, 12 12 Z" />
        </svg>
      </div>

      {/* 欢迎徽标：樱粉渐变圆 + 五瓣樱，轻轻摇晃 */}
      <div class="announce-mascot" aria-hidden="true">
        <svg viewBox="0 0 24 24" class="announce-sakura">
          <g fill="currentColor">
            {[0, 72, 144, 216, 288].map((deg) => (
              <path
                d="M12 12 C 19 9.5, 17.5 3.5, 12 1.5 C 6.5 3.5, 5  9.5, 12 12 Z"
                transform={`rotate(${deg} 12 12)`}
              />
            ))}
            <circle cx="12" cy="12" r="1.6" />
          </g>
        </svg>
        <span class="announce-mascot-dot"></span>
      </div>

      {/* 文案主体：欢迎眉题 + 内容 + 内联链接 */}
      <div class="announce-body">
        <span class="announce-eyebrow">
          <span class="spark" aria-hidden="true">✦</span>
          ようこそ · WELCOME
          <span class="spark" aria-hidden="true">✦</span>
        </span>
        <p class="announce-text">{config.content}</p>
        {config.link?.enable && (
          <a
            href={config.link.external ? config.link.url : url(config.link.url)}
            target={config.link.external ? "_blank" : undefined}
            rel={config.link.external ? "noopener noreferrer" : undefined}
            class="announce-link group"
          >
            {config.link.text}
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.4"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="h-3 w-3 transition-transform duration-200 group-hover:translate-x-0.5"
              aria-hidden="true"
            >
              <path d="M5 12h14M13 6l6 6-6 6"></path>
            </svg>
          </a>
        )}
      </div>

      {config.closable && (
        <button
          type="button"
          id="home-announcement-close"
          aria-label="关闭公告"
          class="announce-close"
        >
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.2"
            stroke-linecap="round"
            class="h-3.5 w-3.5"
            aria-hidden="true"
          >
            <path d="M18 6 6 18M6 6l12 12"></path>
          </svg>
        </button>
      )}
    </div>
  )
}

<style>
	/* ===== 左下角悬浮气泡：替代顶部公告条 ===== */
	/* 放置说明：FloatingControls 占右下角（right:1rem bottom:4rem），故气泡放左下避免冲突；
	   z-index 50 让它浮在内容之上，又在浮动控件之下 */
	#home-announcement {
		position: fixed;
		left: 1.25rem;
		bottom: 1.25rem;
		width: min(320px, calc(100vw - 2rem));
		display: flex;
		align-items: flex-start;
		gap: 0.75rem;
		padding: 0.9rem 1rem 0.85rem;
		overflow: visible;
		border-radius: 18px 18px 18px 6px;
		background:
			radial-gradient(circle at 14% 22%, rgb(255 183 210 / 0.22), transparent 54%),
			radial-gradient(circle at 92% 88%, rgb(199 185 255 / 0.18), transparent 50%),
			rgb(255 240 246 / 0.1);
		border: 1.5px solid rgb(255 183 210 / 0.32);
		box-shadow:
			0 14px 30px -16px rgb(90 20 55 / 0.55),
			inset 0 1px 0 rgb(255 255 255 / 0.2);
		backdrop-filter: blur(12px);
		-webkit-backdrop-filter: blur(12px);
		z-index: 50;
		animation: bubble-in 0.6s cubic-bezier(0.34, 1.56, 0.64, 1) both;
	}

	@keyframes bubble-in {
		0% {
			opacity: 0;
			transform: translateY(16px) scale(0.96);
		}
		100% {
			opacity: 1;
			transform: none;
		}
	}

	/* 气泡小尾巴（左下角，朝向左下） */
	.announce-tail {
		position: absolute;
		left: 22px;
		bottom: -6px;
		width: 12px;
		height: 12px;
		background: rgb(255 240 246 / 0.1);
		border-left: 1.5px solid rgb(255 183 210 / 0.32);
		border-bottom: 1.5px solid rgb(255 183 210 / 0.32);
		border-radius: 2px;
		transform: rotate(45deg);
		pointer-events: none;
	}

	/* ===== 欢迎徽标 ===== */
	.announce-mascot {
		position: relative;
		display: grid;
		flex: none;
		place-items: center;
		width: 2.4rem;
		height: 2.4rem;
		margin-top: 0.05rem;
		border-radius: 999px;
		background: linear-gradient(135deg, rgb(255 151 188 / 0.85), rgb(178 150 255 / 0.85));
		border: 2px solid rgb(255 255 255 / 0.55);
		box-shadow:
			0 6px 14px -8px rgb(240 86 143 / 0.6),
			inset 0 2px 4px rgb(255 255 255 / 0.45);
		color: rgb(255 255 255 / 0.95);
	}

	.announce-sakura {
		width: 1.15rem;
		height: 1.15rem;
		transform-origin: 50% 60%;
		animation: mascot-sway 5.5s ease-in-out infinite;
	}

	@keyframes mascot-sway {
		0%,
		58%,
		100% {
			rotate: 0deg;
		}
		66% {
			rotate: 14deg;
		}
		74% {
			rotate: -11deg;
		}
		82% {
			rotate: 6deg;
		}
		90% {
			rotate: -3deg;
		}
	}

	.announce-mascot-dot {
		position: absolute;
		right: -1px;
		bottom: -1px;
		width: 0.62rem;
		height: 0.62rem;
		border-radius: 999px;
		background: var(--primary);
		border: 2px solid rgb(255 255 255 / 0.8);
		animation: dot-breath 2.6s ease-in-out infinite;
	}

	@keyframes dot-breath {
		0%,
		100% {
			transform: scale(1);
			opacity: 1;
		}
		50% {
			transform: scale(0.72);
			opacity: 0.65;
		}
	}

	/* ===== 文案 ===== */
	.announce-body {
		display: flex;
		flex-direction: column;
		gap: 0.22rem;
		min-width: 0;
		padding-right: 1.3rem;
	}

	.announce-eyebrow {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		font-size: 0.62rem;
		font-weight: 700;
		letter-spacing: 0.22em;
		color: rgb(255 151 188 / 0.95);
		text-shadow: 0 1px 6px rgb(240 86 143 / 0.35);
	}

	.announce-eyebrow .spark {
		font-size: 0.55rem;
		animation: spark-twinkle 2.4s ease-in-out infinite;
	}

	.announce-eyebrow .spark:last-child {
		animation-delay: 1.2s;
	}

	@keyframes spark-twinkle {
		0%,
		100% {
			opacity: 0.45;
			transform: scale(0.85);
		}
		50% {
			opacity: 1;
			transform: scale(1.12);
		}
	}

	.announce-text {
		margin: 0;
		font-size: 0.8rem;
		line-height: 1.55;
		color: rgb(255 255 255 / 0.9);
		text-shadow: 0 1px 6px rgb(0 0 0 / 0.35);
		overflow: hidden;
		display: -webkit-box;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 2;
	}

	.announce-link {
		display: inline-flex;
		align-items: center;
		gap: 0.25rem;
		width: fit-content;
		margin-top: 0.1rem;
		font-size: 0.72rem;
		font-weight: 600;
		color: rgb(255 183 210 / 0.95);
		transition: color 0.2s ease;
	}

	.announce-link:hover {
		color: #fff;
	}

	/* ===== 关闭按钮（气泡内右上角） ===== */
	.announce-close {
		position: absolute;
		top: 0.55rem;
		right: 0.55rem;
		display: flex;
		align-items: center;
		justify-content: center;
		width: 1.4rem;
		height: 1.4rem;
		border-radius: 999px;
		color: rgb(255 255 255 / 0.45);
		background: rgb(255 255 255 / 0.06);
		border: 1px solid rgb(255 255 255 / 0.14);
		transition:
			background 0.2s ease,
			color 0.2s ease,
			rotate 0.3s ease;
	}

	.announce-close:hover {
		color: #fff;
		background: rgb(255 151 188 / 0.3);
		rotate: 90deg;
	}

	/* ===== 飘落樱花瓣装饰 ===== */
	.announce-deco {
		position: absolute;
		inset: 0;
		overflow: hidden;
		border-radius: inherit;
		pointer-events: none;
	}

	.announce-petal {
		position: absolute;
		width: 0.7rem;
		height: 0.7rem;
		color: rgb(255 151 188 / 0.4);
		animation: petal-drift 9s ease-in-out infinite alternate;
	}

	.announce-petal path {
		fill: currentColor;
	}

	.p1 {
		right: 12%;
		top: -14%;
		animation-duration: 8s;
	}

	.p2 {
		right: 32%;
		top: 22%;
		width: 0.5rem;
		height: 0.5rem;
		color: rgb(199 185 255 / 0.38);
		animation-duration: 11s;
		animation-delay: -4s;
	}

	@keyframes petal-drift {
		0% {
			transform: translateY(0) rotate(0deg);
		}
		50% {
			transform: translateY(320%) rotate(150deg);
		}
		100% {
			transform: translateY(80%) rotate(300deg);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		#home-announcement {
			animation: none;
		}
		.announce-sakura,
		.announce-mascot-dot,
		.announce-eyebrow .spark,
		.announce-petal {
			animation: none;
		}
	}
</style>

<script>
  // 公告关闭：按内容记忆（localStorage），内容更新后自动重新显示。
  // 放在组件脚本里随页面执行；非首页或关闭态直接隐藏容器，避免闪烁后消失。
  (function () {
    const KEY = "home-announcement-dismissed";
    const el = document.getElementById("home-announcement");
    if (!el) return;
    const content = el.getAttribute("data-content") || "";
    let dismissed = false;
    try {
      dismissed = localStorage.getItem(KEY) === content;
    } catch (e) {
      dismissed = false;
    }
    if (dismissed) {
      el.style.display = "none";
      return;
    }
    const closeBtn = document.getElementById("home-announcement-close");
    if (closeBtn) {
      closeBtn.addEventListener("click", () => {
        el.style.display = "none";
        try {
          localStorage.setItem(KEY, content);
        } catch (e) {
          /* 隐私模式等场景忽略 */
        }
      });
    }
  })();
</script>