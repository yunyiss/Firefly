---
import { announcementConfig, homeConfig } from "@/config";
import { url } from "@/utils/url-utils";

interface Props {
	class?: string;
	style?: string;
}

const { class: className, style } = Astro.props;

const config = announcementConfig;
// 关闭记忆：按内容记忆，内容更新后公告会重新显示
const dismissKey = "home-announcement-dismissed";
---

{
  homeConfig.announcement?.enable && config.content && (
    <div
      id="home-announcement"
      class:list={["announce-bubble sakura-card", className]}
      style={style}
      data-content={config.content}
      role="status"
      aria-live="polite"
    >
      {/* 装饰：飘落樱花瓣（纯 CSS，reduced-motion 关闭） */}
      <div class="announce-deco" aria-hidden="true">
        <svg class="announce-petal p1" viewBox="0 0 24 24">
          <path d="M12 12 C 19 9.5, 17.5 3.5, 12 1.5 C 6.5 3.5, 5  9.5, 12 12 Z" />
        </svg>
      </div>

      {/* 欢迎徽标：樱粉渐变圆 + 五瓣樱（与首页水印同款 path） */}
      <div class="announce-mascot" aria-hidden="true">
        <svg viewBox="0 0 24 24" class="announce-sakura">
          <g fill="currentColor">
            {[0, 72, 144, 216, 288].map((deg) => (
              <path
                d="M12 12 C 19 9.5, 17.5 3.5, 12 1.5 C 6.5 3.5, 5  9.5, 12 12 Z"
                transform={`rotate(${deg} 12 12)`}
              />
            ))}
            <circle cx="12" cy="12" r="1.6" />
          </g>
        </svg>
        <span class="announce-mascot-dot"></span>
      </div>

      {/* 文案：竖排正文 + 底部箭头链接 */}
      <div class="announce-body">
        <p class="announce-text">{config.content}</p>
        {config.link?.enable && (
          <a
            href={config.link.external ? config.link.url : url(config.link.url)}
            target={config.link.external ? "_blank" : undefined}
            rel={config.link.external ? "noopener noreferrer" : undefined}
            class="announce-link"
            aria-label={config.link.text}
          >
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.4"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="h-3 w-3"
              aria-hidden="true"
            >
              <path d="M5 12h14M13 6l6 6-6 6"></path>
            </svg>
          </a>
        )}
      </div>

      {config.closable && (
        <button
          type="button"
          id="home-announcement-close"
          aria-label="关闭公告"
          class="announce-close"
        >
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.2"
            stroke-linecap="round"
            class="h-3 w-3"
            aria-hidden="true"
          >
            <path d="M18 6 6 18M6 6l12 12"></path>
          </svg>
        </button>
      )}
    </div>
  )
}

<style>
	/* ===== 默认形态：横向气泡（兼容非 explore 调用） ===== */
	#home-announcement {
		position: absolute;
		left: 1.25rem;
		bottom: 1.25rem;
		width: min(320px, calc(100vw - 2rem));
		display: flex;
		align-items: flex-start;
		gap: 0.75rem;
		padding: 0.9rem 1rem 0.85rem;
		overflow: visible;
		border-radius: 18px 18px 18px 6px;
		background:
			radial-gradient(circle at 14% 22%, rgb(255 183 210 / 0.22), transparent 54%),
			radial-gradient(circle at 92% 88%, rgb(199 185 255 / 0.18), transparent 50%),
			rgb(255 240 246 / 0.1);
		border: 1.5px solid rgb(255 183 210 / 0.32);
		box-shadow:
			0 14px 30px -16px rgb(90 20 55 / 0.55),
			inset 0 1px 0 rgb(255 255 255 / 0.2);
		backdrop-filter: blur(12px);
		-webkit-backdrop-filter: blur(12px);
		z-index: 50;
	}

	#home-announcement:not(.announce-in-explore) {
		position: fixed;
		left: 1.25rem;
		bottom: 1.25rem;
		top: auto;
		transform: none;
		opacity: 1;
		transition: none;
	}

	/* ===== 探索场景形态：竖向窄签（贴纸式） ===== */
	/* 挂在 .home-scene 区段左侧的留白处，垂直居中；窄条高度由竖排文字自然撑开 */
	#home-announcement.announce-in-explore {
		position: absolute;
		left: 0.5rem;
		top: 50%;
		transform: translateY(-50%);
		width: 54px;
		flex-direction: column;
		align-items: center;
		gap: 0.7rem;
		padding: 14px 10px 26px;
		border-radius: 16px;
		min-height: 380px;
		/* 滚出后淡出：起始 0，ScrollTrigger 给 .is-visible 时归 1 */
		opacity: 0;
		transition: opacity 0.5s ease-out;
	}

	#home-announcement.announce-in-explore.is-visible {
		opacity: 1;
	}

	/* 窄屏隐藏竖签，避免抢占有限宽度 */
	@media (max-width: 1023px) {
		#home-announcement.announce-in-explore {
			display: none;
		}
	}

	/* ===== 欢迎徽标（顶部） ===== */
	#home-announcement.announce-in-explore .announce-mascot {
		position: relative;
		flex: none;
		order: -1;
		width: 1.8rem;
		height: 1.8rem;
		display: grid;
		place-items: center;
		border-radius: 999px;
		background: linear-gradient(135deg, rgb(255 151 188 / 0.85), rgb(178 150 255 / 0.85));
		border: 1.5px solid rgb(255 255 255 / 0.55);
		box-shadow:
			0 4px 10px -4px rgb(240 86 143 / 0.6),
		inset 0 1px 3px rgb(255 255 255 / 0.45);
		color: rgb(255 255 255 / 0.95);
	}

	#home-announcement.announce-in-explore .announce-sakura {
		width: 0.95rem;
		height: 0.95rem;
		transform-origin: 50% 60%;
		animation: mascot-sway 5.5s ease-in-out infinite;
	}

	@keyframes mascot-sway {
		0%,
		58%,
		100% {
			rotate: 0deg;
		}
		66% {
			rotate: 14deg;
		}
		74% {
			rotate: -11deg;
		}
		82% {
			rotate: 6deg;
		}
		90% {
			rotate: -3deg;
		}
	}

	#home-announcement.announce-in-explore .announce-mascot-dot {
		position: absolute;
		right: -2px;
		bottom: -2px;
		width: 0.5rem;
		height: 0.5rem;
		border-radius: 999px;
		background: var(--primary);
		border: 1.5px solid rgb(255 255 255 / 0.85);
		animation: dot-breath 2.6s ease-in-out infinite;
	}

	@keyframes dot-breath {
		0%,
		100% {
			transform: scale(1);
			opacity: 1;
		}
		50% {
			transform: scale(0.7);
			opacity: 0.65;
		}
	}

	/* ===== 文案主体：竖排中文 + 底部箭头 ===== */
	#home-announcement.announce-in-explore .announce-body {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.65rem;
		min-width: 0;
		flex: none;
	}

	#home-announcement.announce-in-explore .announce-text {
		margin: 0;
		font-size: 0.72rem;
		line-height: 1.55;
		color: rgb(255 255 255 / 0.92);
		text-shadow: 0 1px 6px rgb(0 0 0 / 0.35);
		/* 中文竖排：从右上开始向下读，单列足够 */
		writing-mode: vertical-rl;
		text-orientation: mixed;
		/* 自适应高度，宽度固定 */
		max-height: 56vh;
		overflow: hidden;
		text-overflow: ellipsis;
		/* 内容超长截断——按竖排容器高度截掉 */
	}

	#home-announcement.announce-in-explore .announce-link {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 1.7rem;
		height: 1.7rem;
		margin-bottom: 6px;
		border-radius: 999px;
		color: rgb(255 183 210 / 0.95);
		background: rgb(255 255 255 / 0.06);
		border: 1px solid rgb(255 255 255 / 0.18);
		transition: background 0.2s ease, color 0.2s ease;
	}

	#home-announcement.announce-in-explore .announce-link:hover {
		color: #fff;
		background: rgb(255 151 188 / 0.28);
	}

	/* ===== 关闭按钮（竖签内右上角） ===== */
	#home-announcement.announce-in-explore .announce-close {
		position: absolute;
		top: 4px;
		right: 4px;
		display: flex;
		align-items: center;
		justify-content: center;
		width: 1.05rem;
		height: 1.05rem;
		border-radius: 999px;
		color: rgb(255 255 255 / 0.45);
		background: rgb(255 255 255 / 0.06);
		border: none;
		transition: background 0.2s ease, color 0.2s ease, rotate 0.3s ease;
	}

	#home-announcement.announce-in-explore .announce-close:hover {
		color: #fff;
		background: rgb(255 151 188 / 0.3);
		rotate: 90deg;
	}

	/* ===== 飘落樱花瓣装饰（竖签版位置） ===== */
	#home-announcement.announce-in-explore .announce-deco {
		position: absolute;
		inset: 0;
		overflow: hidden;
		border-radius: inherit;
		pointer-events: none;
	}

	#home-announcement.announce-in-explore .announce-petal {
		position: absolute;
		width: 0.55rem;
		height: 0.55rem;
		color: rgb(255 151 188 / 0.4);
		animation: petal-drift 9s ease-in-out infinite alternate;
	}

	#home-announcement.announce-in-explore .announce-petal path {
		fill: currentColor;
	}

	#home-announcement.announce-in-explore .p1 {
		right: 6px;
		top: -10%;
		animation-duration: 8s;
	}

	@keyframes petal-drift {
		0% {
			transform: translateY(0) rotate(0deg);
		}
		50% {
			transform: translateY(360%) rotate(150deg);
		}
		100% {
			transform: translateY(80%) rotate(300deg);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		#home-announcement.announce-in-explore .announce-sakura,
		#home-announcement.announce-in-explore .announce-mascot-dot,
		#home-announcement.announce-in-explore .announce-petal {
			animation: none;
		}
	}
</style>

<script>
  // 公告关闭：按内容记忆（localStorage），内容更新后自动重新显示。
  // 放在组件脚本里随页面执行；非首页或关闭态直接隐藏容器，避免闪烁后消失。
  (function () {
    const KEY = "home-announcement-dismissed";
    const el = document.getElementById("home-announcement");
    if (!el) return;
    const content = el.getAttribute("data-content") || "";
    let dismissed = false;
    try {
      dismissed = localStorage.getItem(KEY) === content;
    } catch (e) {
      dismissed = false;
    }
    if (dismissed) {
      el.style.display = "none";
      return;
    }
    const closeBtn = document.getElementById("home-announcement-close");
    if (closeBtn) {
      closeBtn.addEventListener("click", () => {
        el.style.display = "none";
        try {
          localStorage.setItem(KEY, content);
        } catch (e) {
          /* 隐私模式等场景忽略 */
        }
      });
    }
  })();
</script>