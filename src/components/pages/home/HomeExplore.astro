---
import { Icon } from "astro-icon/components";
import { homeConfig, siteConfig } from "@/config";
import { url } from "@/utils/url-utils";

interface Props {
	class?: string;
	style?: string;
}

const { class: className, style } = Astro.props;

// 按 siteConfig.pages 过滤被关闭页面的入口
const pages = siteConfig.pages;
const cards = homeConfig.sectionCards.cards.filter(
	(card) =>
		!card.pageKey || pages[card.pageKey as keyof typeof pages] !== false,
);
---

<!-- 探索：标题行 + 软 3D 卡片网格（宽度由父容器 explore-wrap 控制，比时钟区更收窄） -->
<div class:list={["explore-scene flex flex-col", className]} style={style}>
  <div class="explore-head mb-7">
    <h2 class="explore-title">
      <span class="index">01</span>
      {homeConfig.sectionCards.title}
    </h2>
    {
      homeConfig.sectionCards.subtitle && (
        <p class="explore-subtitle">{homeConfig.sectionCards.subtitle}</p>
      )
    }
  </div>

  <div class="explore-grid">
    {
      cards.map((card) => (
        <a
          href={card.external ? card.url : url(card.url)}
          target={card.external ? "_blank" : undefined}
          rel={card.external ? "noopener noreferrer" : undefined}
          class="explore-card"
        >
          <span class="explore-ico">
            <Icon is:inline name={card.icon} aria-hidden="true" />
          </span>
          <span class="explore-name">{card.name}</span>
          <span class="explore-desc">{card.description}</span>
          <Icon
            is:inline
            name="material-symbols:arrow-forward-rounded"
            class="explore-arrow"
            aria-hidden="true"
          />
        </a>
      ))
    }
  </div>
</div>

<style>
	.explore-head {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
	}

	.explore-title {
		display: flex;
		align-items: baseline;
		gap: 0.75rem;
		font-size: 1.5rem;
		font-weight: 700;
		color: #fff;
		text-shadow: 0 3px 18px rgb(0 0 0 / 0.5);
	}

	.explore-title .index {
		font-family: var(--font-mono, monospace);
		font-size: 0.875rem;
		color: rgb(255 255 255 / 0.45);
	}

	.explore-subtitle {
		font-size: 0.875rem;
		color: rgb(255 255 255 / 0.55);
		text-shadow: 0 2px 10px rgb(0 0 0 / 0.45);
	}

	/* 紧凑软 3D 卡片：4 列（移动端 2 列） */
	.explore-grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 1rem;
	}

	@media (min-width: 900px) {
		.explore-grid {
			grid-template-columns: repeat(4, 1fr);
		}
	}

	.explore-card {
		position: relative;
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		padding: 1.15rem 1.1rem;
		border-radius: 18px;
		overflow: hidden;
		background: rgb(255 240 246 / 0.08);
		border: 1.5px solid rgb(255 183 210 / 0.24);
		box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.18);
		transition:
			transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1),
			border-color 0.25s ease,
			box-shadow 0.25s ease,
			background 0.25s ease;
	}

	.explore-card:hover {
		transform: translateY(-6px) rotate(-1deg);
		border-color: rgb(255 151 188 / 0.65);
		background: rgb(255 240 246 / 0.14);
		box-shadow:
			0 18px 36px -16px rgb(240 86 143 / 0.5),
			inset 0 1px 0 rgb(255 255 255 / 0.26);
	}

	.explore-ico {
		width: 38px;
		height: 38px;
		border-radius: 12px;
		display: grid;
		place-items: center;
		color: var(--primary);
		background: rgb(255 127 169 / 0.18);
		box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.25);
		transition:
			transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1),
			background 0.25s ease;
	}

	.explore-ico :global(svg) {
		width: 18px;
		height: 18px;
	}

	.explore-card:hover .explore-ico {
		transform: scale(1.12) rotate(-8deg);
		background: rgb(255 127 169 / 0.32);
	}

	.explore-name {
		font-weight: 700;
		font-size: 0.95rem;
		color: rgb(255 255 255 / 0.92);
		text-shadow: 0 2px 12px rgb(0 0 0 / 0.4);
	}

	.explore-desc {
		font-size: 0.75rem;
		line-height: 1.6;
		color: rgb(255 255 255 / 0.55);
	}

	.explore-arrow {
		position: absolute;
		right: 1rem;
		bottom: 1rem;
		width: 0.9rem;
		height: 0.9rem;
		color: var(--primary);
		opacity: 0;
		transform: translateX(-6px);
		transition:
			opacity 0.25s ease,
			transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
	}

	.explore-card:hover .explore-arrow {
		opacity: 1;
		transform: translateX(0);
	}
</style>
